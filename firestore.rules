rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validReview(data) {
      return data.keys().hasAll([
          'userId', 'albumId', 'rating', 'textContent', 'listenedAt',
          'likesCount', 'isRewatch'
        ])
        && data.keys().hasOnly([
          'userId', 'albumId', 'rating', 'textContent', 'listenedAt',
          'likesCount', 'isRewatch', 'favoriteTrackId', 'trackId'
        ])
        && data.rating is number
        && data.rating >= 0.5
        && data.rating <= 5
        && data.rating % 0.5 == 0
        && data.textContent is string
        && data.textContent.size() <= 2000
        && data.listenedAt is timestamp
        && data.likesCount is int
        && data.likesCount == 0
        && data.isRewatch is bool
        && (!('trackId' in data) || data.trackId is string)
        && (!('favoriteTrackId' in data) || data.favoriteTrackId is string);
    }

    function validList(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && data.description is string
        && data.description.size() <= 500
        && data.albumIds is list
        && data.albumIds.size() <= 100
        && data.likesCount is int
        && data.isPublic is bool;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && validReview(request.resource.data);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && validReview(request.resource.data);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if ownsUser(userId)
        && request.resource.data.displayName is string
        && request.resource.data.username is string
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 450000
        && request.resource.data.stats.albumsLogged == 0
        && request.resource.data.stats.reviewsCount == 0
        && request.resource.data.stats.listsCount == 0;
      allow update: if ownsUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'username', 'bio', 'avatarUrl', 'photoURL',
          'favoriteAlbums', 'lastfmUsername', 'spotifyConnected',
          'integrations'
        ])
        && (!('favoriteAlbums' in request.resource.data)
          || request.resource.data.favoriteAlbums.size() <= 4)
        && (!('bio' in request.resource.data)
          || request.resource.data.bio.size() <= 160)
        && (!('photoURL' in request.resource.data)
          || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 450000));
      allow delete: if ownsUser(userId);
    }

    match /lists/{listId} {
      allow read: if resource.data.isPublic == true
        || (signedIn() && resource.data.ownerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.likesCount == 0
        && validList(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'albumIds', 'isPublic'
        ])
        && validList(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
